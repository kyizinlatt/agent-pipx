{
  "name": "core",
  "description": "Stack-agnostic guards (secrets, .env, CI-idle push, hygiene), workflow commands and subagents.",
  "repository": "https://github.com/kyizinlatt/agent-pipx",
  "license": "Apache-2.0",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-push.sh",
            "timeout": 25,
            "statusMessage": "Checking CI is idle before push…"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-env.sh",
            "timeout": 10,
            "statusMessage": "Blocking .env reads…"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-env.sh",
            "timeout": 10,
            "statusMessage": "Blocking .env reads…"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-hygiene.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
